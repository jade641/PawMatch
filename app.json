{
  "expo": {
    "name": "PawMatch",
    "slug": "PawMatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pawmatch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pawmatch.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F47A2C",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pawmatch.mobile",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FF7043"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PawMatch uses your photos so you can add pictures of your dog and upload vaccination, health and pedigree documents.",
          "cameraPermission": "PawMatch uses the camera so you can photograph your dog's vaccination, health and pedigree documents."
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
