# ── App configuration (copy to .env) ─────────────────────────────────
# Supabase → Project Settings → API. The anon key is public by design;
# row-level security in the database protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://eurfqyiwvqpvujlcchgu.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImV1cmZxeWl3dnFwdnVqbGNjaGd1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEyODU1NDQsImV4cCI6MjEwNjg2MTU0NH0.QEMcB9xxf7fJBTi90R4fCSz_pE0m8c9x3o3sROJCwj4

# Optional: address shown under Help & About → Contact support.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Optional: shows "Demo Access" buttons on the login screen that fill in the
# seeded demo accounts. Use the same value as DEMO_PASSWORD in .env.seed.
EXPO_PUBLIC_DEMO_PASSWORD=

# Optional: show Google sign-in (enable the provider in Supabase first).
EXPO_PUBLIC_ENABLE_SOCIAL_LOGIN=true


# ── Admin scripts only (put these in .env.seed, NOT in .env) ─────────
